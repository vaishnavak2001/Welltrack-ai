# Database Configuration
# For development, SQLite is used by default. Set this for PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/welltrackdb
DATABASE_URL=sqlite:///welltrack.db

# Application Settings
APP_NAME=WellTrackAI
APP_VERSION=1.0.0
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-in-production

# Email Notifications (Optional - notifications are logged if not configured)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@welltrack.ai
HR_EMAIL=hr@company.com
